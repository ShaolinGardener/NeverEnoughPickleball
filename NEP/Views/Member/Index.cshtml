@model IEnumerable<NEP.Models.Member>

@{
    ViewData["Title"] = "Members List";
}

<h1>Members List</h1>

<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Screen Name</th>
            <th>Company</th>
            <th>Date of Birth</th>
            <th>City</th>
            <th>State</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@item.ScreenName</td>
                <td>@item.CompanyOrOrganization</td>
                <td>@item.DateOfBirth.ToShortDateString()</td>
                <td>@item.City</td>
                <td>@item.State</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="Create" class="btn btn-primary">Add New Member</a>
</div>
    